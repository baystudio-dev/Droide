<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    

    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">0:0:0:0:0:0:0:1</domain>
        <domain includeSubdomains="false">ip6-localhost</domain>
    </domain-config>
    <!-- Internal OkHttp names pinned to the private IPv4 address in the user's 9Router settings. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">nine-router-lan.invalid</domain>
    </domain-config>
</network-security-config>
